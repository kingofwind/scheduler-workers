{
  "$schema": "https://opencode.ai/config.json",
  // 复制以下 bash 权限到你的项目 opencode.jsonc（与本项目原有权限合并）。
  // Copy this bash permission block into your project's opencode.jsonc.
  "permission": {
    "bash": {
      // 核心四件套：子串匹配，兼容 "$p = Start-Process ..." 等复合写法。
      // Core four: substring match so compound one-liners (e.g. "$p = Start-Process ...") work.
      "*Start-Process*": "allow",
      "*Wait-Process*": "allow",
      "*Set-Content*": "allow",
      "*Add-Content*": "allow",
      // 等待/时间/进程状态/JSON 序列化（低风险）。
      // Wait / time / process state / JSON serialization (low risk).
      "*Start-Sleep*": "allow",
      "*Get-Process*": "allow",
      "*Get-Date*": "allow",
      "*ConvertTo-Json*": "allow",
      "*ConvertFrom-Json*": "allow",
      // 锁助手用 .NET IO（可写/删任意文件，中风险）。
      // Lock helper uses .NET IO (can write/delete files, medium risk).
      "*System.IO.File*": "allow",
      "*System.IO.Directory*": "allow",
      // 主 agent 运行事件循环脚本。
      // Main agent runs the event-loop script.
      "powershell*": "allow"
    }
  }
}
